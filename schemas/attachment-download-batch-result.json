{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/attachment-download-batch-result.json",
  "title": "AttachmentBatchResult",
  "description": "Result of `attachment download` in bulk mode: one or more `--bug <ID>` targets, one or more positional attachment-ID targets, or both. Single-target download emits `download-result` instead. `bug_results[]` covers each `--bug <ID>`; `attachment_results[]` covers each positional attachment ID. A bug entry's `status: \"error\"` can still carry partial `files[]` when some of that bug's attachments were written before the failure. `summary` aggregates both lists.",
  "type": "object",
  "properties": {
    "out_dir": {
      "type": "string"
    },
    "bug_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bugDownloadResult"
      }
    },
    "attachment_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachmentDownloadResult"
      }
    },
    "summary": {
      "$ref": "#/$defs/batchSummary"
    }
  },
  "required": ["out_dir", "bug_results", "attachment_results", "summary"],
  "additionalProperties": false,
  "$defs": {
    "targetStatus": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "downloadedFile": {
      "type": "object",
      "properties": {
        "attachment_id": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["attachment_id", "path", "bytes"],
      "additionalProperties": false
    },
    "bugDownloadResult": {
      "type": "object",
      "description": "Result of one `--bug <ID>` target. `files` is omitted when empty; `error` is present only when `status` is `\"error\"`, and holds the first error message encountered for this bug.",
      "properties": {
        "bug_id": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/targetStatus" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/downloadedFile" }
        },
        "error": { "type": "string" }
      },
      "required": ["bug_id", "status"],
      "additionalProperties": false
    },
    "attachmentDownloadResult": {
      "type": "object",
      "description": "Result of one positional attachment-ID target. `bug_id` is populated from the API response when reachable, even on failure. `path`/`bytes` are present only on success; `error` is present only on failure.",
      "properties": {
        "attachment_id": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/targetStatus" },
        "bug_id": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      },
      "required": ["attachment_id", "status"],
      "additionalProperties": false
    },
    "batchSummary": {
      "type": "object",
      "properties": {
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["succeeded", "failed", "total_bytes"],
      "additionalProperties": false
    }
  }
}
