{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/bug.json",
  "title": "Bug",
  "description": "The object emitted by `bug view` (single) and each element of the `bug list`/`bug search`/`bug my` arrays. Server-specific custom fields are flattened in as additional top-level properties. The `--fields`/`--exclude-fields` options may project the property set, so any built-in property may be absent. Permission-gated fields such as `estimated_time` and `remaining_time` may also be absent when the server withholds them. For those reasons `required` is empty.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "resolution": {
      "type": ["string", "null"]
    },
    "dupe_of": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "deadline": {
      "type": ["string", "null"]
    },
    "product": {
      "type": ["string", "null"]
    },
    "component": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "version": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "assigned_to": {
      "type": ["string", "null"]
    },
    "priority": {
      "type": ["string", "null"]
    },
    "severity": {
      "type": ["string", "null"]
    },
    "creation_time": {
      "type": ["string", "null"]
    },
    "last_change_time": {
      "type": ["string", "null"]
    },
    "creator": {
      "type": ["string", "null"]
    },
    "url": {
      "type": ["string", "null"]
    },
    "whiteboard": {
      "type": ["string", "null"]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "op_sys": {
      "type": ["string", "null"]
    },
    "platform": {
      "type": ["string", "null"]
    },
    "target_milestone": {
      "type": ["string", "null"]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_time": {
      "type": ["number", "null"]
    },
    "remaining_time": {
      "type": ["number", "null"]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"] },
          "setter": { "type": ["string", "null"] },
          "requestee": { "type": ["string", "null"] }
        }
      }
    }
  },
  "required": [],
  "additionalProperties": true
}
