{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/batch-result.json",
  "title": "BatchResult",
  "description": "Result of a batch `bug update`.",
  "type": "object",
  "properties": {
    "resource": {
      "type": "string",
      "enum": ["bug", "attachment", "comment", "user", "group", "product", "component", "server"]
    },
    "action": {
      "type": "string",
      "enum": ["created", "updated", "added", "removed", "renamed", "downloaded", "dry-run"]
    },
    "succeeded": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "resource",
    "action",
    "succeeded",
    "failed"
  ],
  "additionalProperties": false
}
