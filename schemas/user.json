{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/user.json",
  "title": "User",
  "description": "A Bugzilla user (`BugzillaUser`) as emitted in `--format json` output.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string"
    },
    "real_name": {
      "type": ["string", "null"]
    },
    "email": {
      "type": ["string", "null"]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "can_login": {
      "type": ["boolean", "null"]
    }
  },
  "required": [
    "id",
    "name",
    "real_name",
    "email",
    "groups",
    "can_login"
  ],
  "additionalProperties": false
}
