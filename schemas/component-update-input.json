{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/component-update-input.json",
  "title": "ComponentUpdateInput",
  "description": "Object payload accepted by `component update --from-json`.",
  "type": "object",
  "properties": {
    "id": {
      "type": ["integer", "null"],
      "minimum": 0,
      "examples": [42]
    },
    "product": {
      "type": ["string", "null"],
      "examples": ["MyApp"]
    },
    "component": {
      "type": ["string", "null"],
      "examples": ["Backend"]
    },
    "name": {
      "type": ["string", "null"],
      "examples": ["backend"]
    },
    "description": {
      "type": ["string", "null"],
      "examples": ["Backend services"]
    },
    "default_assignee": {
      "type": ["string", "null"],
      "examples": ["dev@example.com"]
    }
  },
  "required": [],
  "additionalProperties": false
}
