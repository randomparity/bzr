{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomparity/bzr/schemas/user-create-input.json",
  "title": "UserCreateInput",
  "description": "Object payload accepted by `user create --from-json`. Required create fields may be supplied by JSON or explicit CLI flags, so this schema describes payload shape rather than post-merge command validity.",
  "type": "object",
  "properties": {
    "email": {
      "type": ["string", "null"],
      "examples": ["alice@example.com"]
    },
    "login": {
      "type": ["string", "null"],
      "examples": ["alice"]
    },
    "full_name": {
      "type": ["string", "null"],
      "examples": ["Alice Smith"]
    },
    "password": {
      "type": ["string", "null"],
      "examples": ["s3cret"]
    }
  },
  "required": [],
  "additionalProperties": false
}
