FROM python:3.14.7-slim-bookworm

# The staged bzr comparison artifact uses the default keyring feature, whose
# Linux backend links libdbus. Keep this fixture dependency local to the
# sidecar that executes that artifact.
RUN apt-get update && apt-get install -y --no-install-recommends libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir python-bugzilla==3.3.0

CMD ["sleep", "infinity"]
