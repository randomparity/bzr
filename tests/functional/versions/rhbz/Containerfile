FROM docker.io/library/fedora:39

RUN dnf -y install mariadb-server mariadb httpd mod_perl perl-interpreter \
        perl-CGI perl-DBI perl-DBD-MySQL perl-DateTime perl-Email-MIME perl-Memoize perl-Safe \
        perl-Email-Sender perl-Encode perl-JSON-XS perl-Template-Toolkit \
        perl-URI perl-XMLRPC-Lite perl-App-cpanminus gmp-devel openssl-devel gnupg2 which git && dnf clean all

RUN git clone https://pagure.io/Red-Hat-Bugzilla/rh-bugzilla.git /var/www/html/bugzilla \
    && cd /var/www/html/bugzilla \
    && git checkout --detach 167ccca1b256f9462cb4aebcb1edbced7e4663d5 \
    && test "$(git rev-parse HEAD)" = 167ccca1b256f9462cb4aebcb1edbced7e4663d5 \
    && mysql_install_db --user=mysql --datadir=/var/lib/mysql

# CPAN archives retain owner IDs that are invalid in rootless CI image builds.
# cpanm resolves tar from PATH, so suppress ownership restoration there only.
RUN printf '%s\n' '#!/bin/sh' 'exec /usr/bin/tar "$@" --no-same-owner' > /usr/local/bin/tar \
    && chmod +x /usr/local/bin/tar

# This public source snapshot carries production field IDs. They do not apply
# to a fresh database, so keep the fields but omit their stale dependencies.
RUN sed -i '/^  \(visibility_field_id\|value_field_id\|visibility_values\):/d' \
        /var/www/html/bugzilla/extensions/RedHat/custom_fields.yaml \
    && sed -i 's/SELECT count (\*)/SELECT count(*)/' \
        /var/www/html/bugzilla/extensions/RedHat/lib/Schema.pm

RUN cpanm --notest Math::Random::ISAAC Mail::GPG HTTP::BrowserDetect JSON::RPC \
        Test::Taint Email::Address Net::DNS Crypt::JWT Daemon::Generic Crypt::CBC \
        Crypt::DES Crypt::DES_EDE3 File::pushd Text::Diff Parallel::ForkManager \
        Log::Log4perl::Layout::JSON List::Compare Net::SAML2 File::Slurp \
        Crypt::OpenPGP Crypt::SMIME GnuPG::Interface DateTime::Format::DBI

RUN cpanm --notest TheSchwartz

RUN cpanm --notest Path::Class

# This production-data migration assumes a pre-existing Bugzilla product and
# bot accounts; neither is part of the fresh disposable smoke database.
RUN sed -i '/## REDHAT EXTENSION START 2186036/,/## REDHAT EXTENSION END 2186036/d' \
        /var/www/html/bugzilla/extensions/RedHat/lib/Schema.pm

# RedHat's filesystem hook uses this module's qualified permission helper but
# does not load the module on the REST path.
RUN sed -i '/^use Bugzilla::Flag;/a use Bugzilla::Install::Filesystem ();' \
        /var/www/html/bugzilla/extensions/RedHat/Extension.pm

# The pinned fork's WebService asks for these legacy list accessors although
# its Bug model stores one scalar component/version. Keep this compatibility
# bounded to those stored values; it does not implement multi-value versions.
RUN sed -i '/^1;$/i sub all_components { return [$_[0]->component]; }\nsub all_component_objs { return [$_[0]->component_obj]; }\nsub all_versions { return [$_[0]->version]; }' \
        /var/www/html/bugzilla/Bugzilla/Bug.pm
RUN sed -i '/^1;$/i sub rule_group { return undef; }' \
        /var/www/html/bugzilla/Bugzilla/Product.pm

# The pinned RHBZ fork issues PostgreSQL's statement-timeout command, while
# this disposable fixture uses MariaDB. Preserve the timeout behavior with
# MariaDB's equivalent session setting so bounded RHBZ searches can run.
RUN sed -i 's/SET STATEMENT_TIMEOUT TO /SET max_statement_time = /; s/(\$timeout \* 1000)/\$timeout/; s/SET STATEMENT_TIMEOUT TO 0/SET max_statement_time = 0/' \
        /var/www/html/bugzilla/Bugzilla/DB.pm

# RedHat's schema explicitly reads AgileTools tables. Keep that companion with
# the three extensions this lifecycle verifies. Its group setup also uses
# SecureMail's `secure_mail` option.
RUN find /var/www/html/bugzilla/extensions -mindepth 1 -maxdepth 1 -type d \
        ! -name AgileTools ! -name ExternalBugs ! -name RedHat ! -name SecureMail \
        ! -name SubComponents -exec rm -rf -- {} +

RUN dnf -y install perl-DBD-Pg perl-Graph-Easy perl-HTML-Scrubber perl-IPC-Run perl-JSON-Any \
        perl-LDAP perl-List-MoreUtils perl-List-UtilsBy perl-Regexp-Common \
        perl-TimeDate perl-YAML-Syck && dnf clean all

RUN sed -i 's|DocumentRoot "/var/www/html"|DocumentRoot "/var/www/html/bugzilla"|' /etc/httpd/conf/httpd.conf \
    && printf '%s\n' '<Directory "/var/www/html/bugzilla">' 'AddHandler cgi-script .cgi' \
      'Options +ExecCGI +FollowSymLinks' 'Require all granted' '</Directory>' \
      'RewriteEngine On' 'RewriteRule ^/rest/(.*)$ /rest.cgi/$1 [L]' > /etc/httpd/conf.d/bugzilla.conf \
    && echo 'LoadModule rewrite_module modules/mod_rewrite.so' >> /etc/httpd/conf.modules.d/00-rewrite.conf

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 80
CMD ["/entrypoint.sh"]
